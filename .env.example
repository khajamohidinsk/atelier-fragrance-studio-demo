# Local-only AI (free; no API key). Start Ollama before starting the Atelier server.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5-coder:7b
AI_API_URL=http://127.0.0.1:11434/api/chat
AI_TIMEOUT_MS=120000
PORT=8787

# The server does not auto-load this file. Set these variables in your shell before npm start.
# For a remote OpenAI-compatible provider, set AI_PROVIDER=openai-compatible and provide:
# AI_API_URL=https://provider.example/v1/chat/completions
# AI_API_KEY=server-only-secret
# AI_MODEL=provider-model-name
